{
  "manifest_version": 3,
  "name": "Noir",
  "version": "3.0.0",
  "description": "A dark developer workspace new tab — ox-alpha browser agent, search, calendar, extensions.",
  "minimum_chrome_version": "138",
  "permissions": ["management", "storage", "tabs", "scripting", "history", "bookmarks"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
